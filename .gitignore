# Python bytecode
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/*.pyo
**/*.pyd

# Distribution / packaging
**/*.egg
**/*.egg-info/
**/dist/
**/build/
**/eggs/

# Virtual environments
**/venv/
**/env/
**/.venv/
**/ENV/

# Environment / secrets / credentials
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.crt
**/*.p12
**/secrets.*
**/credentials.*

# ML model weights (large binary files)
**/*.pt
**/*.pth
**/*.bin
**/*.onnx
**/*.safetensors
**/*.h5
**/*.hdf5

# FAISS index files
**/*.faiss
**/*.pkl
**/*.pickle
**/faiss_index/*
!**/faiss_index/.gitkeep

# Downloaded models cache
**/models/*
!**/models/.gitkeep

# IDE / editor
**/.idea/
**/.vscode/
**/*.swp
**/*.swo
**/*~

# OS files
**/.DS_Store
**/Thumbs.db

# Logs
**/*.log
**/*.pid

# Jupyter
**/.ipynb_checkpoints/

# Testing / coverage
**/.pytest_cache/
**/htmlcov/
**/.coverage
**/.tox/
**/.mypy_cache/

# Database files
**/*.sqlite3
**/*.db